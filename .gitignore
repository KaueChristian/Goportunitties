# binaries
*.exe
*.dll
*.so
*.dylib
/goportunitties
/goportunitties-worker

# test binary
*.test

# coverage
*.out
coverage.html

# runtime state: the SQLite file and its write-ahead log, wherever DB_PATH
# points — /data/ covers the default, the patterns below cover a custom path
/data/
*.db
*.db-shm
*.db-wal

# secrets: every .env variant (.env, .env.local, .env.production, ...), never
# just the exact name — an ADMIN_KEY or GitHub token in any of them must not
# be committed. Re-allow a template if one is ever added.
.env*
!.env.example

# runtime logs
*.log

# built frontend, embedded into the Go binary at build time
internal/web/dist/*
!internal/web/dist/.gitkeep

# OS / editor junk at the repo root (frontend/.gitignore covers its own tree)
.DS_Store
Thumbs.db
.vscode/
.idea/
